{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "templates/**,static/**,frontend/public/**,data/**,backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=$1"
    }
  ]
}
